rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Who may author listing content at all. firestore.rules gates listings/{id} create
    // on isApprovedAgent() && !isBlocked(); this mirrors that same gate for the bucket, so
    // the two halves of "publish a listing" cannot disagree. Without it, any account that
    // could sign up — including one an admin had blocked — could upload unlimited 12MB
    // images into its own folder and serve them from the project's public bucket, with no
    // listing and no moderation anywhere in the picture. Cross-service reads into Firestore
    // are the same mechanism deal-documents below already uses; "(default)" is the correct
    // literal for this project's single unnamed database.
    function storageUserDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function isStorageOwner() {
      return request.auth != null && request.auth.token.email == 'bbayraaa20@gmail.com';
    }
    function isApprovedUploader() {
      return request.auth != null && (
        isStorageOwner() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && storageUserDoc().get('blocked', false) == false
          && (storageUserDoc().get('agentActive', false) == true
              || storageUserDoc().get('role', 'user') == 'admin'))
      );
    }

    // Listing photos — path is scoped by the uploader's own uid, mirroring how
    // firestore.rules scopes every listing write to request.auth.uid == ownerId.
    // Public read: listing photos are shown to logged-out visitors on the public
    // site, but only an approved, unblocked agent (or admin/owner) can write into
    // their own folder, and only real images under 12MB — matching the client-side
    // size guard in my-listings.js.
    match /listing-images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && isApprovedUploader()
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Delete stays scoped to the folder's owner without the agent check: an agent whose
      // access was later revoked must still be able to clean up their own old uploads.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // CRM deal contracts/documents — path is scoped by the uploading agent's own uid, same
    // shape as listing-images/{uid}/{fileName} above. Unlike listing photos, these are
    // NEVER public: only the owning agent, or admin/owner (checked via a cross-service read
    // into Firestore's users/{uid}.role — Storage rules can call firestore.get()/exists()
    // the same way Firestore rules call get() on themselves; "(default)" is the correct
    // literal here since this project uses Firestore's single default database, not a
    // named one) can read, write, or delete. Size/type match the client-side guard in
    // js/crm.js's document-upload flow.
    match /deal-documents/{agentId}/{dealId}/{fileName} {
      function isOwnerOrAdminStorage() {
        return request.auth != null && (
          request.auth.token.email == 'bbayraaa20@gmail.com' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
      allow read: if request.auth != null && (request.auth.uid == agentId || isOwnerOrAdminStorage());
      allow write: if request.auth != null && request.auth.uid == agentId
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|image/jpeg|image/jpg|image/png|application/msword|application/vnd\\.openxmlformats-officedocument\\.wordprocessingml\\.document');
      allow delete: if request.auth != null && (request.auth.uid == agentId || isOwnerOrAdminStorage());
    }

    // CMS media (page/organization images uploaded from the admin editor). Public read so
    // the published site can show them; write/delete only for an admin or the owner, and
    // only real images under 12MB. Mirrors the isOwnerOrAdminStorage() cross-service check
    // already used by deal-documents. Path is admin-scoped, not tied to listing ownership.
    match /cms-media/{fileName} {
      function isCmsEditor() {
        return request.auth != null && (
          request.auth.token.email == 'bbayraaa20@gmail.com' ||
          (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
        );
      }
      allow read: if true;
      allow write: if isCmsEditor()
                   && request.resource.size < 12 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isCmsEditor();
    }

    // Everything else stays closed by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
