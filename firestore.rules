rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== ROLES =====
    // Three roles: 'owner' (exactly one, hardcoded below), 'admin' (granted/revoked only by
    // the owner, through the privileged users/{uid} update rule further down), 'user'
    // (everyone else, the default). There is no backend/Cloud Functions in this app, so this
    // is the server-authoritative root of the whole permission system — every other check in
    // this file, and every admin UI gate in the app, ultimately traces back to these four
    // helpers. The owner's email is the ONE hardcoded literal in the entire system (mirrored
    // client-side only in js/permissions.js, for UI — never trusted there for security) —
    // isOwner() reads it off request.auth.token.email, which comes from the verified Firebase
    // ID token itself and cannot be spoofed by any client-supplied document data.
    function ownerEmail() { return 'bbayraaa20@gmail.com'; }
    function isSignedIn() { return request.auth != null; }
    function isOwner() { return isSignedIn() && request.auth.token.email == ownerEmail(); }
    function userRole(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('role', 'user');
    }
    function isAdmin() { return isSignedIn() && userRole(request.auth.uid) == 'admin'; }
    function isAdminOrOwner() { return isAdmin() || isOwner(); }

    // A blocked user can no longer create or edit listings — set by an admin/owner (see the
    // users/{uid} rules below), never by the user themselves.
    function isBlocked() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('blocked', false) == true;
    }

    // ===== AGENTS (closed brokerage system) =====
    // TP Property is no longer an open marketplace: signing in no longer grants the ability
    // to create/manage listings by itself. `agentActive` is a new, orthogonal boolean on
    // users/{uid} (default false) — an admin/owner explicitly flips it on via the Agents
    // admin section (or it's set at signup time when a matching agentInvites/{email} doc
    // exists, see the users/{uid} create rule below). `role` itself is untouched — a plain
    // 'user' role is displayed as "Agent" client-side (js/permissions.js roleLabel()), but the
    // real, server-enforced gate for listing authorship is this flag, not the role string.
    // Admin/owner always count as an approved agent too — they don't need the flag set.
    function isActiveAgent() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('agentActive', false) == true;
    }
    function isApprovedAgent() { return isActiveAgent() || isAdminOrOwner(); }

    // ===== USERS =====
    match /users/{uid} {
      // Everyone reads their own profile; admin/owner can read any profile (Users management
      // page — this covers both single-doc get() and the list() query it runs).
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdminOrOwner());

      // Bootstrap on first sign-in. The owner's own email is the only address ever allowed
      // to create itself as role:'owner' — everyone else can only ever create themselves as
      // 'user' (or omit the field entirely). Nobody can hand themselves 'admin' at signup.
      //
      // agentActive at signup: a brand-new account can only ever land with agentActive:true
      // if a matching agentInvites/{email} doc already exists (an admin/owner pre-authorized
      // that exact email before this signup happened) — checked against the verified token
      // email, not anything client-supplied, so a client can't just self-grant agent access
      // by setting the field. Everyone else bootstraps with agentActive:false (or omitted).
      allow create: if isSignedIn() && request.auth.uid == uid && (
        (isOwner() && request.resource.data.role == 'owner') ||
        (!isOwner() && (!('role' in request.resource.data) || request.resource.data.role == 'user'))
      ) && (
        request.resource.data.get('agentActive', false) == false ||
        exists(/databases/$(database)/documents/agentInvites/$(request.auth.token.email))
      );

      // Self-update: every field is free to edit except `role`, which must stay exactly what
      // it already is — a signed-in user can never grant themselves admin (or owner) this way.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      // Owner self-heal: the create rule above only ever runs once, the moment a profile doc
      // is first created — an owner account whose doc already existed before this role system
      // shipped (e.g. they'd used the app previously under the old rules, which only ever
      // allowed role:'user') would otherwise have no path to ever reach role:'owner', since
      // the self-update rule right above explicitly forbids a role change. This is the one
      // narrow exception: only the verified owner email, only on their own row, only landing
      // on exactly 'owner' — it can't be used by anyone else, and can't set any other role.
      allow update: if isOwner() && request.auth.uid == uid
                    && request.resource.data.role == 'owner'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);

      // ===== PRIVILEGED ROLE MANAGEMENT — OWNER ONLY =====
      // The one and only path by which `role` may ever change to/from 'admin'. Scoped tightly:
      // - only the owner (verified token email) can call it
      // - never on the owner's own row (immutable — this rule can't touch a doc it's also
      //   reading as the target, since request.auth.uid != uid excludes self-targeting, and
      //   the resource.data.role != 'owner' guard below blocks it even if that were bypassed)
      // - can never target a row that is currently 'owner' — there is only ever one, and this
      //   path can't create a second one or demote the real one
      // - the new role can only be 'admin' or 'user' — never 'owner' — so this path can never
      //   mint a second owner account either
      // - touches nothing but role (+ an updatedAt timestamp for the audit trail)
      allow update: if isOwner() && request.auth.uid != uid
                    && resource.data.get('role', 'user') != 'owner'
                    && request.resource.data.role in ['admin', 'user']
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt']);

      // Block/unblock a user. Admin may only ever touch a plain 'user' row (never another
      // admin, never the owner); the owner may touch anyone except themselves. Scoped to
      // exactly the `blocked` field — this path can never touch `role`.
      allow update: if isAdmin() && resource.data.get('role', 'user') == 'user'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked']);
      allow update: if isOwner() && request.auth.uid != uid
                    && resource.data.get('role', 'user') != 'owner'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blocked']);

      // No one can delete a profile doc through the client — the owner's row is immutable by
      // definition, and deleting any other user's row would silently orphan their listings/
      // favorites/chats. (Account deletion, if ever needed, is a Firebase-Console operation.)
      allow delete: if false;
    }

    // ===== AGENT INVITES =====
    // How an admin/owner grants agent access to someone who has never signed in yet (there's
    // no backend/Admin SDK here, so a Firestore Auth account can't be created server-side —
    // the client has to bootstrap its own users/{uid} doc on first sign-in). An admin/owner
    // pre-authorizes an exact email address by writing a doc keyed by that email; the users/
    // {uid} create rule above cross-checks this collection via exists() before ever letting a
    // brand-new signup set agentActive:true on itself. `get` is scoped to the invitee's own
    // verified token email so this doesn't need to be publicly listable to do its job.
    match /agentInvites/{email} {
      allow get: if isSignedIn() && request.auth.token.email == email;
      allow list: if isAdminOrOwner();
      allow create, update, delete: if isAdminOrOwner();
    }

    // ===== LISTINGS =====
    // Lifecycle: pending (just submitted/edited, awaiting review) -> active (admin/owner-
    // approved, public) -> sold/rented (owner marks complete) or expired (30 days, auto) ->
    // closed. Admin/owner can also reject (pending -> rejected) at any point during review.
    // Only status == 'active' is ever returned by the public read query (loadPublicListings
    // in data.js), so this field is what actually gates visibility — not a separate
    // "published" flag.
    match /listings/{listingId} {
      allow read: if true;

      // A brand-new listing can't already be admin-verified or start out publicly visible —
      // otherwise a malicious owner could just set listingVerified/status themselves. Blocked
      // users can't create listings at all. Only an approved agent (or admin/owner) may author
      // a listing — a merely-signed-in account with no agentActive flag cannot.
      allow create: if isSignedIn()
                    && isApprovedAgent()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.get('listingVerified', false) == false
                    && request.resource.data.get('status', 'pending') == 'pending'
                    && !isBlocked();

      // Owner can edit/delete their own listing, with guardrails: they can never flip
      // listingVerified into true (only the admin/owner moderation rule below can), never
      // reset their own reportCount (would let a scammer erase their reports), and can't move
      // `status` anywhere except the transitions that don't require a human review — any edit
      // resets to 'pending' (my-listings.js does this on every save), an expired listing can
      // be renewed straight back to 'active' (content didn't change), and an active listing
      // can be marked sold/rented/expired by its own owner. Only an admin/owner can move
      // something INTO 'active' from 'pending'/'rejected', or move it INTO 'rejected' at all.
      // A deactivated agent (agentActive:false) loses this self-edit path entirely — their
      // existing listings stay live/public, but only admin/owner can touch them going forward.
      // This rule is also what lets an approved agent write the 14-day "Шинэчлэх" refresh
      // (lastRefreshedAt only) — not field-whitelisted, so a refresh-only update already
      // satisfies every guard above with no separate rule needed.
      allow update: if isSignedIn() && isApprovedAgent() && resource.data.ownerId == request.auth.uid
                    && !isBlocked()
                    && !(request.resource.data.get('listingVerified', false) == true
                         && resource.data.get('listingVerified', false) != true)
                    && request.resource.data.get('reportCount', 0) == resource.data.get('reportCount', 0)
                    && (
                         request.resource.data.get('status', 'pending') == resource.data.get('status', 'pending') ||
                         request.resource.data.status == 'pending' ||
                         (resource.data.status == 'expired' && request.resource.data.status == 'active') ||
                         (resource.data.status == 'active' && request.resource.data.status in ['sold', 'rented', 'expired'])
                       );
      allow delete: if isSignedIn() && isApprovedAgent() && resource.data.ownerId == request.auth.uid;

      // Anyone (including logged-out viewers) may bump viewCount by exactly 1, nothing else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;

      // Any signed-in user may bump reportCount by exactly 1 (reporting someone else's listing).
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount'])
                    && request.resource.data.reportCount == resource.data.reportCount + 1;

      // Admin/owner moderation — approve/reject/hide/refresh from the admin dashboard, scoped
      // to only the fields it touches, never full content. Rejecting requires a real,
      // non-empty reason (the owner sees it on their own listing) — enforced here, not just
      // in the UI. lastRefreshedAt is included so Admin can refresh ANY agent's listing
      // (including one whose agent has since been deactivated) — still narrowly scoped, an
      // admin refresh can never touch status/listingVerified/rejectionReason/content/images.
      allow update: if isAdminOrOwner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'listingVerified', 'rejectionReason', 'lastRefreshedAt'])
                    && (request.resource.data.get('status', '') != 'rejected' || request.resource.data.get('rejectionReason', '').size() > 0);

      // Admin/owner can hard-delete any listing (spam/abuse) — owners can only delete their
      // own, via the rule above. The moderation UI always pairs this with an adminAuditLogs
      // entry carrying the reason (a delete request itself carries no document body, so a
      // reason can't be enforced on the delete call in the rules the way it is for reject).
      allow delete: if isAdminOrOwner();
    }

    // ===== NEW DEVELOPMENTS (барилгын компанийн шинэ төслүүд) =====
    match /projects/{projectId} {
      allow read: if true;

      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;

      // Owner can edit/delete their own project; admin/owner can moderate (hide/edit/delete)
      // any project the same way they moderate listings.
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdminOrOwner();

      // Anyone (including logged-out viewers) may bump viewCount by exactly 1, nothing else.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
                    && request.resource.data.viewCount == resource.data.viewCount + 1;

      // Any signed-in user may bump contactCount by exactly 1 (revealed the phone number).
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contactCount'])
                    && request.resource.data.contactCount == resource.data.contactCount + 1;
    }

    // ===== ADVERTISING (banner / sponsored / featured placements) =====
    // Public read so the site itself can render active ads to every visitor; only admin/owner
    // can create, edit, or remove one.
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrOwner();
    }

    // ===== FAVORITES =====
    match /favorites/{favId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Owner may update their own favorite doc (used to track priceAtSave for price-drop alerts).
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
    }

    // ===== SAVED SEARCHES =====
    match /savedSearches/{searchId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ===== NOTIFICATIONS =====
    // Written client-side (no Cloud Functions): saved-search matches and price-drop alerts
    // are created by the current user's own browser after checking real listings, so create
    // is scoped to the owner just like reads. Delete is disallowed — "mark all read" only
    // ever flips `read`, never removes the doc.
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ===== REPORTS =====
    // Write-only from a regular client — reporting a listing never lets you read other
    // people's reports. The admin dashboard is the one reader/moderator.
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdminOrOwner();
      allow update: if isAdminOrOwner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ===== ADMIN AUDIT LOGS =====
    // Every privileged admin/owner action (approve/reject/delete a listing, block a user,
    // grant/revoke admin, manage an ad) writes one immutable entry here. No client — admin,
    // owner, or otherwise — can ever update or delete a log entry once written; the log can
    // only grow. An actor can only ever write themselves as `actorUid` (never attribute an
    // action to someone else). The owner can read every entry; an admin can only read their
    // own — matching "Admin өөрийн audit log-оо delete хийж болохгүй" (they can't touch it at
    // all, delete included) while still letting them see their own moderation history.
    match /adminAuditLogs/{logId} {
      allow create: if isAdminOrOwner() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isOwner() || (isAdmin() && resource.data.actorUid == request.auth.uid);
      allow update, delete: if false;
    }

    // ===== TRANSACTIONS (boost purchase history — demo payment, real tracking) =====
    match /transactions/{txnId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ===== CHATS =====
    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                      && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===== CRM: CLIENTS =====
    // A sales lead/contact tracked through the pipeline (stage: new -> contacted -> viewing ->
    // negotiation -> contract -> closed_sold/closed_rented). assignedAgentId is the single
    // field that scopes an agent's access — an agent only ever sees/edits clients where they
    // are the assigned agent; admin/owner see and edit everything. Only admin/owner can ever
    // reassign a client to a different agent, or create one pre-assigned to someone else.
    match /clients/{clientId} {
      allow read: if isSignedIn() && (isAdminOrOwner() || resource.data.assignedAgentId == request.auth.uid);

      // An approved agent may create a client, but only self-assigned — they can't hand a new
      // lead to a colleague. Admin/owner may create a client assigned to anyone (including
      // themselves).
      allow create: if isSignedIn() && !isBlocked() && isApprovedAgent()
                    && (request.resource.data.assignedAgentId == request.auth.uid || isAdminOrOwner());

      // Agent branch: can only touch their own assigned client, and assignedAgentId must stay
      // exactly what it already was — reassignment is admin/owner only (second branch, no such
      // restriction). isActiveAgent() (not isApprovedAgent()) deliberately here: a deactivated
      // agent loses this self-edit path entirely, same precedent as the listings self-edit rule
      // — read stays open above so their history remains visible.
      allow update: if isSignedIn() && !isBlocked() && (
                      (isActiveAgent()
                        && resource.data.assignedAgentId == request.auth.uid
                        && request.resource.data.assignedAgentId == resource.data.assignedAgentId)
                      || isAdminOrOwner()
                    );

      allow delete: if isAdminOrOwner();
    }

    // ===== CRM: VIEWINGS =====
    // A scheduled/completed showing, linked to a client and a listing. agentId is denormalized
    // straight onto this doc (copied from clients/{clientId}.assignedAgentId by the app at
    // write time) specifically so this collection's rules can scope on it directly, without a
    // get() lookup into clients on every read/write.
    match /viewings/{viewingId} {
      allow read: if isSignedIn() && (isAdminOrOwner() || resource.data.agentId == request.auth.uid);

      allow create: if isSignedIn() && !isBlocked() && isApprovedAgent()
                    && (request.resource.data.agentId == request.auth.uid || isAdminOrOwner());

      allow update: if isSignedIn() && !isBlocked() && (
                      (isActiveAgent()
                        && resource.data.agentId == request.auth.uid
                        && request.resource.data.agentId == resource.data.agentId)
                      || isAdminOrOwner()
                    );

      allow delete: if isAdminOrOwner();
    }

    // ===== CRM: DEALS =====
    // A deal in progress or closed, linked to a client and a listing. agentId is denormalized
    // the same way as viewings.agentId, same reason. Closing a deal (status -> 'sold'/'rented')
    // does NOT itself touch listings/{id} — the app performs that as a second, separate write
    // using the listing's own existing {status}-only update path (my-listings.js
    // markSoldRented() for the owning agent, admin.js adminMarkListingStatus() for admin/owner)
    // — no listings rule changes needed or made here.
    match /deals/{dealId} {
      allow read: if isSignedIn() && (isAdminOrOwner() || resource.data.agentId == request.auth.uid);

      allow create: if isSignedIn() && !isBlocked() && isApprovedAgent()
                    && (request.resource.data.agentId == request.auth.uid || isAdminOrOwner());

      allow update: if isSignedIn() && !isBlocked() && (
                      (isActiveAgent()
                        && resource.data.agentId == request.auth.uid
                        && request.resource.data.agentId == resource.data.agentId)
                      || isAdminOrOwner()
                    );

      allow delete: if isAdminOrOwner();
    }

    // ===== CRM: CLIENT ACTIVITIES (append-only audit timeline) =====
    // One entry per event on a client's journey (created, reassigned, stage changed,
    // follow-up done/scheduled, viewing scheduled/done/cancelled, deal created/status
    // changed, contract added, closed sold/rented). Deliberately carries NO agentId field
    // of its own — access is decided by a LIVE lookup of the referenced client's CURRENT
    // clients/{clientId}.assignedAgentId, not a snapshot taken when each entry was
    // written. That's what makes a reassigned client's full history (including entries
    // the previous agent wrote) immediately visible to whoever is assigned now, instead of
    // only entries written after the handoff. Queried as
    // .where('clientId','==',id).orderBy('createdAt','desc') — a single equality filter,
    // which the rules engine can prove invariant across the whole result set since every
    // returned doc resolves the same get() target for a given clientId.
    match /clientActivities/{activityId} {
      allow read: if isSignedIn() && (
        isAdminOrOwner() ||
        (exists(/databases/$(database)/documents/clients/$(resource.data.clientId))
          && get(/databases/$(database)/documents/clients/$(resource.data.clientId)).data.assignedAgentId == request.auth.uid)
      );

      allow create: if isSignedIn() && !isBlocked() && isApprovedAgent()
                    && request.resource.data.actorUid == request.auth.uid
                    && exists(/databases/$(database)/documents/clients/$(request.resource.data.clientId))
                    && (
                         isAdminOrOwner() ||
                         get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.assignedAgentId == request.auth.uid
                       );

      // A real audit log — nobody, not even admin/owner, can edit or erase history once
      // written. If a referenced client is later deleted, its activity entries become
      // permanently orphaned (readable only by admin/owner via the isAdminOrOwner()
      // branch above, since the exists() check then fails for everyone else) — there's no
      // backend here to cascade-delete them, and leaving them in place (rather than
      // silently vanishing) is the more honest audit-trail behavior.
      allow update, delete: if false;
    }
  }
}
